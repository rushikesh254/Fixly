# ---------------------------------------------------------------------------
# Fixly backend configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- server ---------------------------------------------------------------
PORT=1337
NODE_ENV=development

# Browser origin allowed to call this API with credentials. Must be the exact
# scheme + host + port of the frontend.
CROSS_ORIGIN=http://localhost:5173

# Public URL of the SPA. Used to build email verification and password reset
# links, so it must be an address a real user can open.
CLIENT_URL=http://localhost:5173

# Public URL of this API. The verification link points here first, then the
# API redirects the browser on to CLIENT_URL.
BACKEND_URL=http://localhost:1337

# --- database -------------------------------------------------------------
# Local:  mongodb://localhost:27017/fixly
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/fixly?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/fixly

# --- auth -----------------------------------------------------------------
# Two different secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# --- google sign in (optional) -------------------------------------------
# OAuth 2.0 Web Client ID from console.cloud.google.com.
# Leave blank to keep the "Continue with Google" button disabled.
# Must match VITE_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=

# --- image uploads (cloudinary) ------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- transactional email (smtp) ------------------------------------------
# Dev:  Mailtrap sandbox (sandbox.smtp.mailtrap.io, port 2525) traps every mail.
# Prod: a verified sending domain, e.g. Brevo, Resend, SES or Postmark.
# Port 465 implies TLS, 587 implies STARTTLS.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
